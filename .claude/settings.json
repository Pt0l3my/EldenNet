{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Artifact|SendUserFile|WebFetch|WebSearch|mcp__github__.*|mcp__Claude_Docs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.config/privsweep/privsweep.py\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/tools/privsweep/privsweep.py\"; exec python3 -I -S \"$f\" hook",
            "timeout": 900,
            "onFailure": "block",
            "statusMessage": "Privacy sweep"
          }
        ]
      }
    ]
  }
}
