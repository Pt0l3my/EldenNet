{
  "format": "datapiler-job/1",
  "id": "en-0012-realm-bosses",
  "title": "Bosses (e): the characters placed in boss slots of the expansion's open world",
  "needs": "0.2.10",
  "ops": [
    {"op": "load_maps", "maps": ["m61_*"]},
    {"op": "read_placements", "as": "placed", "maps": ["m61_*"]},
