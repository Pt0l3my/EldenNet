    {"op": "count", "as": "placed_per_map", "rows": "placed", "by": ["map"]},
    {"op": "write_share", "name": "realm-bosses", "tables": ["placed_per_map", "bosses"],
     "columns": {"placed_per_map": ["map", "count"], "bosses": ["map", "entityId", "npcParamId", "model"]},
     "notes": ["vanilla_rows"]}
  ]
}
