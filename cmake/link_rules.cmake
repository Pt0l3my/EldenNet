# ARCH §2.3's dependency rules on the link graph, checked when the build is configured, in the spirit of ARCH §12.1's
# greps: a module that may link only some of ours names them, and a link that reaches any other target of the build,
# directly or through another library, stops the configuration with the chain that reaches it.
#
#   en_link_rule(<target> ALLOW <target>...)
#
# The walk follows every target's LINK_LIBRARIES and INTERFACE_LINK_LIBRARIES (PRIVATE and PUBLIC alike, and a static
# library's private links, which reach the program's link line as $<LINK_ONLY:...>), and counts every target named
# inside a generator expression as reached, whatever its condition, so the check errs on the side of refusing. Only
# targets are checked: a system library (comdlg32, the Windows SDK's) is not a module of ours. The rules are checked
# once, at the end of the top-level directory, so that a link added anywhere after the rule is seen too; a rule on a
# target the build does not make (eldennet-launcher outside the Windows builds) checks nothing.
function(en_link_rule target)
  cmake_parse_arguments(PARSE_ARGV 1 rule "" "" "ALLOW")
  if(rule_UNPARSED_ARGUMENTS OR NOT rule_ALLOW)
    message(FATAL_ERROR "en_link_rule(${target} ALLOW <target>...): ${rule_UNPARSED_ARGUMENTS}")
  endif()
  string(REPLACE ";" "," allowed "${rule_ALLOW}")
  set_property(GLOBAL APPEND PROPERTY EN_LINK_RULES "${target}=${allowed}")
  get_property(scheduled GLOBAL PROPERTY EN_LINK_RULES_SCHEDULED)
  if(NOT scheduled)
    set_property(GLOBAL PROPERTY EN_LINK_RULES_SCHEDULED ON)
    cmake_language(DEFER DIRECTORY ${PROJECT_SOURCE_DIR} CALL en_check_link_rules)
  endif()
endfunction()

# The targets one link item names: the item itself, or each name inside a generator expression.
function(_en_link_targets out item)
  set(found "")
  if(item MATCHES "\\$<")
    string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" names "${item}")
  else()
    set(names "${item}")
  endif()
  foreach(name IN LISTS names)
    if(TARGET "${name}")
      get_target_property(aliased "${name}" ALIASED_TARGET)
      if(aliased)
        set(name "${aliased}")
      endif()
      list(APPEND found "${name}")
    endif()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(en_check_link_rules)
  get_property(rules GLOBAL PROPERTY EN_LINK_RULES)
  foreach(rule IN LISTS rules)
    string(REGEX REPLACE "=.*" "" target "${rule}")
    string(REGEX REPLACE "^[^=]*=" "" allowed "${rule}")
    string(REPLACE "," ";" allowed "${allowed}")
    if(NOT TARGET ${target})
      continue()
    endif()
    # Breadth first; seen and parents run in step, each target with the one it was reached from.
    set(seen ${target})
    set(parents "")
    set(queue ${target})
    while(NOT queue STREQUAL "")
      list(POP_FRONT queue current)
      foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(items ${current} ${property})
        if(NOT items)
          continue()
        endif()
        foreach(item IN LISTS items)
          _en_link_targets(reached "${item}")
          foreach(next IN LISTS reached)
            if(next IN_LIST seen)
              continue()
            endif()
            list(APPEND seen ${next})
            list(APPEND parents ${current})
            if(NOT next IN_LIST allowed)
              set(chain ${next})
              set(step ${next})
              while(NOT step STREQUAL target)
                list(FIND seen ${step} at)
                math(EXPR at "${at} - 1")
                list(GET parents ${at} step)
                string(PREPEND chain "${step} -> ")
              endwhile()
              string(REPLACE ";" ", " allowed_text "${allowed}")
              message(FATAL_ERROR "ARCH §2.3: ${target} reaches ${next} (${chain}); it may link only ${allowed_text} "
                "of this build's targets")
            endif()
            list(APPEND queue ${next})
          endforeach()
        endforeach()
      endforeach()
    endwhile()
  endforeach()
endfunction()
