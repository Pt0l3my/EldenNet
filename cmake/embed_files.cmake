# en_embed_files: text files built into a program as constexpr string views (no file is read at run time). The
# generated source defines `std::span<const TYPE> FUNCTION() noexcept` in NAMESPACE, TYPE being an aggregate of two
# string views (name, text) that INCLUDE declares, with FUNCTION. Used for Augur's shipped rule files, which v0.1 has
# no content loader to read: en-core builds them in, and en-augur's tests and benchmark read the same files so in
# every build, the Windows ones under Wine included. A change to a file re-runs the configuration.
function(en_embed_files output)
  cmake_parse_arguments(E "" "INCLUDE;NAMESPACE;TYPE;FUNCTION" "FILES" ${ARGN})
  set(body "// Generated by cmake/embed_files.cmake: do not edit.\n#include \"${E_INCLUDE}\"\n\n#include <array>\n\n")
  string(APPEND body "namespace ${E_NAMESPACE} {\nnamespace {\n")
  set(entries "")
  set(n 0)
  foreach(file IN LISTS E_FILES)
    file(READ ${file} text)
    if(text MATCHES "\\)EN_EMBED\"")
      message(FATAL_ERROR "${file} holds the raw string's delimiter")
    endif()
    get_filename_component(name ${file} NAME)
    string(APPEND body "constexpr std::string_view kFile${n} = R\"EN_EMBED(${text})EN_EMBED\";\n")
    string(APPEND entries "    ${E_TYPE}{\"${name}\", kFile${n}},\n")
    math(EXPR n "${n} + 1")
  endforeach()
  string(APPEND body "constexpr std::array<${E_TYPE}, ${n}> kFiles = {\n${entries}};\n}  // namespace\n\n")
  string(APPEND body "std::span<const ${E_TYPE}> ${E_FUNCTION}() noexcept { return kFiles; }\n\n}  // namespace ${E_NAMESPACE}\n")
  file(WRITE ${output}.in "${body}")
  configure_file(${output}.in ${output} COPYONLY)  # rewritten only when it changes
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${E_FILES})
endfunction()
