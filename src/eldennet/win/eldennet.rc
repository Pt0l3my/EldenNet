// eldennet.dll's version resource: ProductName EldenNet, which the launcher's pre-flight checks (ARCH §4.3, E08).
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x2
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "EldenNet"
      VALUE "FileDescription", "EldenNet: NPC conversations for Elden Ring (first in-game build)"
      VALUE "FileVersion", "0.1.0.0"
      VALUE "InternalName", "eldennet"
      VALUE "LegalCopyright", "MIT licence"
      VALUE "OriginalFilename", "eldennet.dll"
      VALUE "ProductName", "EldenNet"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
