    {
      "id": "settings.developer",
      "category": "settings",
      "name": "Developer",
      "description": "Options for testing EldenNet and reporting its problems.",
      "help": {
        "purpose": "Turn on what helps EldenNet's testers: the debug view, recordings of each session and a more detailed log.",
        "steps": [
          "Turn on Developer views for the F11 debug view, from the next start of the game.",
          "Turn on Record sessions to keep each session's numbers for the developers' tools.",
          "Choose how much the log writes; System › Logs shows it."
        ]
      },
