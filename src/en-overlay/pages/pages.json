    {
      "id": "system.logs",
      "category": "system",
      "name": "Logs",
      "description": "EldenNet's own log of this session, with nothing personal in it.",
      "help": {
        "purpose": "Read what EldenNet has written to its log this session. It holds EldenNet's own words and numbers only.",
        "steps": [
          "Read the newest lines at the end of the log.",
          "Change how much it writes with Log detail; the change applies at once.",
          "Keep the page open while you play: new lines join the log as they are written."
        ]
      },
      "related": [
        "system.status",
        "settings.developer"
