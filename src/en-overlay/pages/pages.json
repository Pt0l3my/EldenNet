    {
      "id": "ai.providers",
      "category": "ai",
      "name": "Providers",
      "description": "Where EldenNet's model calls go, with whose key, and whether each answers.",
      "help": {
        "purpose": "Set up where EldenNet's model calls go: your preset's provider or one of your own, and each one's key.",
        "steps": [
          "Press Add the preset's provider, or fill in a name and a base URL under Your own provider.",
          "Paste each provider's key on its row. It is kept on this PC and never shown again.",
          "Press List models to check that every provider answers and serves the models your jobs use.",
          "Remove a provider no job uses with Remove on its row; its key goes with it."
        ]
      },
      "related": [
        "ai.models",
        "ai.selftest"
      ],
      "increment": "0.2",
      "actions": [
        {
          "id": "add",
          "label": "Add the preset's provider",
          "command": "providers.add",
          "tone": "primary"
        },
        {
          "id": "list",
          "label": "List models",
          "command": "models.list",
          "tone": "secondary"
        }
      ],
      "sections": [
        {
          "id": "now",
          "title": "Now",
          "blocks": [
            {
              "kind": "component",
              "component": "computed_sentence",
              "topic": "ai.status"
            }
          ]
        },
        {
          "id": "providers",
          "title": "Providers",
          "description": "Each key is written to this PC only, and never shown again.",
          "blocks": [
            {
              "kind": "component",
              "component": "table",
              "topic": "providers",
              "props": {
                "empty": "No provider yet: add the preset's provider, or one of your own below."
              },
              "row_actions": [
                {
                  "id": "remove",
                  "label": "Remove",
                  "command": "providers.remove",
                  "key": "id",
                  "tone": "destructive",
                  "confirm": "Remove this provider and its key? If you add it back, you must paste its key again."
                }
              ],
              "row_secret": {
                "column": "key",
                "command": "providers.key",
                "key": "id"
              }
            },
            {
              "kind": "shortcuts",
              "keys": [
                "ai.preset"
              ]
            }
          ]
        },
        {
          "id": "own",
          "title": "Your own provider",
          "description": "A server that speaks the OpenAI API: a cloud service at an https:// address, or a server on this PC.",
          "blocks": [
            {
              "kind": "form",
              "command": "providers.add",
              "fields": [
                {
                  "id": "name",
                  "label": "Name",
                  "max": 32
                },
                {
                  "id": "base_url",
                  "label": "Base URL",
                  "max": 200
                }
              ],
              "submit": "Add"
            }
          ]
        },
        {
          "id": "listed",
          "title": "Models listed",
          "blocks": [
            {
              "kind": "component",
              "component": "check_list",
              "topic": "providers",
              "props": {
                "empty": "Press List models to ask each provider for its models."
              }
            }
          ]
        },
        {
          "id": "health",
          "title": "Health",
          "blocks": [
            {
              "kind": "component",
              "component": "table",
              "topic": "health",
              "props": {
                "empty": "No provider yet."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ai.models",
      "category": "ai",
      "name": "Models",
      "description": "Which model does each job, and the preset that sets them all.",
      "help": {
        "purpose": "See which model does each job, choose the preset that sets them all, and choose a job's model yourself.",
        "steps": [
          "Choose a preset. Cloud budget, on OpenRouter, suits most players.",
          "Read each job's provider, model and fallback. A job with no model of its own uses Conversation's.",
          "Choose a job's model from what its provider lists: press List models on Providers first. Reset it to use the preset's again.",
          "Open Self-test to check that the models answer quickly enough."
        ]
      },
      "related": [
        "ai.providers",
        "ai.selftest"
