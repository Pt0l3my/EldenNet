    {
      "id": "ai.providers",
      "category": "ai",
      "name": "Providers",
      "description": "Where EldenNet's model calls go, with whose key, and whether each answers.",
      "help": {
        "purpose": "Set up where EldenNet's model calls go: the provider your preset names, and its key.",
        "steps": [
          "Choose a preset on Models, then press Add provider: its provider joins the list.",
          "Paste the provider's key under Keys. It is kept on this PC and never shown again.",
          "Press List models to check that the provider answers and serves the models your jobs use.",
          "Remove unused providers clears out those no job uses, with their keys."
        ]
      },
      "related": [
        "ai.models",
        "ai.selftest"
      ],
      "increment": "0.2",
